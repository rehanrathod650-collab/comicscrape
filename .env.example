# Database Configuration
# Local SQLite default (zero configuration needed):
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/comicscrape?schema=public"

# Server Port
PORT=3001

# App URL
APP_URL="http://localhost:5173"

# GitHub Integration
# Optional personal access token (increases rate limits from 60 to 5,000 req/hr)
GITHUB_TOKEN=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Telegram Integration
# Optional API credentials for authorized channel access
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_BOT_TOKEN=""

# Security & Sessions
SESSION_SECRET="comic-scrape-super-secret-key-change-in-production"

# Redis Queue (Optional, in-memory queue used by default)
REDIS_URL=""
